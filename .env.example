# API key authentication (comma-separated, leave empty to disable)
# Clients must send X-API-Key header
WA_API_KEYS=
WA_OPERATIONAL_API_KEYS=

# Rate limiting (per-IP and global, sliding window)
# Normal endpoints: default 30 requests per IP per minute, 200 global per minute
WA_RATE_LIMIT_IP_WINDOW_MS=60000
WA_RATE_LIMIT_IP_MAX=30
WA_RATE_LIMIT_GLOBAL_WINDOW_MS=60000
WA_RATE_LIMIT_GLOBAL_MAX=200

# Operational endpoints (restart-socket, restart, logout): stricter limits
# Default 5 requests per 5 minutes per IP
WA_RATE_LIMIT_OPERATIONAL_WINDOW_MS=300000
WA_RATE_LIMIT_OPERATIONAL_MAX=5

# Request queue: max concurrent requests and queue size
WA_QUEUE_MAX_CONCURRENT=10
WA_QUEUE_MAX_SIZE=50
WA_QUEUE_TIMEOUT_MS=30000

